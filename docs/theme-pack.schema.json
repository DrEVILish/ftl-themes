{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ftl-themes local theme pack",
  "type": "object",
  "required": ["formatVersion", "name", "slug", "contract", "minimumLibraryVersion", "css", "license"],
  "properties": {
    "formatVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "contract": {"type": "integer", "minimum": 4},
    "minimumLibraryVersion": {"type": "string", "minLength": 1},
    "css": {"type": "string", "pattern": "^[^/].*\\.css$"},
    "assets": {"type": "array", "items": {"type": "string", "pattern": "^[^/].*"}},
    "icons": {"type": "string", "pattern": "^[^/].*\\.svg$"},
    "variants": {"type": "array", "items": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}}}},
    "license": {"type": "object", "required": ["name", "notice"], "properties": {"name": {"type": "string"}, "notice": {"type": "string"}}}
  },
  "additionalProperties": false
}
